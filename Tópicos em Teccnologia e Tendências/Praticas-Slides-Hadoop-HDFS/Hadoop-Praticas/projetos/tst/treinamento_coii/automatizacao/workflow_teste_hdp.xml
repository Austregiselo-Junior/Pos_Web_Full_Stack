<workflow-app xmlns="uri:oozie:workflow:0.4" name="ingestao_tst_treinamento_coii_${tabelaTesteHdp}">
	<global>
		<job-tracker>${jobTracker}</job-tracker>
		<name-node>${nameNode}</name-node>
	</global>
	
	<start to="Copy_Files"/>

	<action name='Copy_Files'>
		<shell xmlns="uri:oozie:shell-action:0.1">
			<job-tracker>${jobTracker}</job-tracker>
			<name-node>${nameNode}</name-node>
			<exec>hdfs</exec>
			<argument>dfs</argument>
			<argument>-cp</argument>
			<argument>-f</argument>
			<argument>${diretorioDados}/ex_${tabelaTesteHdp}/*</argument>
			<argument>${stagingAreaTesteHdp}</argument>
		</shell>

		<ok to="Insert_Into_Table" />
		<error to="Kill_Job" />
	</action>
	
	<action name="Insert_Into_Table">
		<hive2
			xmlns="uri:oozie:hive2-action:0.1">
			<jdbc-url>${jdbcUrl}</jdbc-url>
			<script>${diretorioScripts}/${tabelaTesteHdp}_insert.sql</script>
		</hive2>
		<ok to="end"/>
		<error to="Kill_Job"/>
	</action>

	<kill name="Kill_Job">
		<message>Job failed</message>
	</kill>
	<end name="end"/>
</workflow-app>