      },
      "source": [
        "np.random.seed(1000) \n",
        " \n",
        "(X_train10, Y_train10), (X_test10, Y_test10) = cifar10.load_data() \n",
        "(X_train100, Y_train100), (X_test100, Y_test100) = cifar100.load_data() "
      ],
      "execution_count": 0,
      "outputs": [
