    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "5j1eBXFJsi5P",
        "colab_type": "code",
        "outputId": "9b33e4e8-ea0b-4d13-bc6d-b2bf6143d21b",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 112
        }
      },
      "source": [
        "model.compile(loss='categorical_crossentropy',\n",
        "              optimizer=Adam(lr=0.0001, decay=1e-6),\n",
        "              metrics=['accuracy'])"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "text": [
            "W0617 14:42:42.832509 140556780173184 deprecation_wrapper.py:119] From /usr/local/lib/python3.6/dist-packages/keras/optimizers.py:790: The name tf.train.Optimizer is deprecated. Please use tf.compat.v1.train.Optimizer instead.\n",
            "\n",
            "W0617 14:42:42.841515 140556780173184 deprecation_wrapper.py:119] From /usr/local/lib/python3.6/dist-packages/keras/backend/tensorflow_backend.py:3295: The name tf.log is deprecated. Please use tf.math.log instead.\n",
            "\n"
          ],
          "name": "stderr"
        }
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "-pF4rcjCtDeR",
        "colab_type": "code",
        "outputId": "75a263a6-47b1-4b1e-b22c-eec0b2c5b1c1",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 546
        }
      },
      "source": [
        "model.fit(X_train / 255.0, to_categorical(Y_train),\n",
        "          batch_size=128,\n",
        "          shuffle=True,\n",
        "          epochs=10,\n",
        "          validation_data=(X_test / 255.0, to_categorical(Y_test)))\n",
        "\n",
        "scores = model.evaluate(X_test / 255.0, to_categorical(Y_test))\n",
        "\n",
        "print('Loss: %.3f' % scores[0])\n",
        "\n",
        "print('Accuracy: %.3f' % scores[1])"
      ],
      "execution_count": 0,
      "outputs": [
        {
          "output_type": "stream",
          "text": [
